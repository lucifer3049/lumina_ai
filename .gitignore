# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── 環境與 secrets（.env.example 才進版控）──
.env
.env.*
!.env.example

# ── Node / 前端 ──
node_modules/
dist/
.vite/
# pnpm 的內容可定址儲存區。WSL2 下 pnpm 會自己把 store 建在專案所在磁碟
# （實測為 /mnt/d/.pnpm-store，因為家目錄的 ext4 與 /mnt/d 跨檔案系統、無法 hardlink），
# 預設落在 repo 之外；這條是防止有人把 store-dir 改到 repo 內時整包被提交。
.pnpm-store/

# ── 壓測產出 ──
loadtest/results/
*.log

# make start 的背景行程 pid 與 log
.run/

# ── 不進版控：個人設定與筆記 ──
# ⚠️ 以下內容**沒有任何版本保護**，誤刪即永久遺失，請自行備份。
CLAUDE.md
新文字文件.txt
環境指令.md

# 註：docs/ 已納入版控——程式碼註解大量引用 docs/plan
#     （如「09 §1.3」「11 §4.1」），clone 下來的人看得到被引用的來源。

# ── 編輯器 / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db

# JWT 簽章金鑰（本機以 `make gen-jwt-keys` 產生；正式環境走 Secrets Manager）
backend/.secrets/

# ── 評測資料（2B-0）──
# 原始資料集的下載快取：我們提交的是取樣後的子集（evaluation/corpus、goldenset），
# 整份 2 MB 的來源檔進版控只是讓 clone 變慢，而它隨時可以由 make eval-sample 重抓。
backend/evaluation/.cache/
# 報告只提交 baseline：它是「改動之前的分數」，是之後每一次比較的對照組，必須進版控。
# 其餘每次跑出來的報告是過程產物。
backend/evaluation/reports/*
!backend/evaluation/reports/baseline_*.json
