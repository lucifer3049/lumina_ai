# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── 環境與 secrets（.env.example 才進版控）──
.env
.env.*
!.env.example

# ── Node / 前端 ──
node_modules/
dist/
.vite/
# pnpm 的內容可定址儲存區。WSL2 下 pnpm 會自己把 store 建在專案所在磁碟
# （實測為 /mnt/d/.pnpm-store，因為家目錄的 ext4 與 /mnt/d 跨檔案系統、無法 hardlink），
# 預設落在 repo 之外；這條是防止有人把 store-dir 改到 repo 內時整包被提交。
.pnpm-store/

# ── 壓測與 spike 產出 ──
loadtest/results/
# 由 make seed 產生，可重現，不進版控
# （註：以下這行原本把說明寫在同一行。.gitignore 的 # 只有在**行首**才是註解，
#   寫在後面會變成 pattern 的一部分，於是這條規則從來沒有生效過。）
backend/loadtest/tenants.json
*.log

# ── 不進版控：個人設定與筆記 ──
# ⚠️ 以下內容**沒有任何版本保護**，誤刪即永久遺失，請自行備份。
CLAUDE.md
新文字文件.txt
環境指令.md

# 註：docs/ 已納入版控——程式碼註解大量引用 docs/plan
#     （如「09 §1.3」「11 §4.1」），clone 下來的人看得到被引用的來源。

# ── 編輯器 / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db
