# Phase 0 開發環境變數樣板 —— 複製為 `.env` 後再改值（`.env` 已 gitignore）。
#
# 這一份是 **compose 與 backend 共用的唯一來源**（CLAUDE.md 鐵則 9）：
# docker/compose.yml 的 ${VAR} 與 Django / AppSettings 讀的環境變數同名同值，
# 不另存第二份。tests/integration/test_infra_config.py 會驗證 compose 用到的
# 每個變數都出現在本檔——加服務忘了補這裡會紅燈。
#
# 埠位一律用非預設值：本機已有原生 PostgreSQL(5432) / Redis(6379) 的機器很常見，
# 撞埠的症狀是「連得上但資料不對」，比連不上更難查。

# ── PostgreSQL ────────────────────────────────────────────────
# 三個角色，職責不重疊（05 §5.1、13 §3.1）。三組帳號與密碼都不得重複——
# 重複的後果不是「權限寬一點」而是拆分完全不存在，且完全沒有症狀。
DB_NAME=lumina
# initdb superuser：只用來建下面兩個角色（與 break-glass 的 `make psql`）。
# 它豁免 RLS policy，所以絕不能當應用連線帳號。
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-locally-su
# schema owner：Django migration、pytest 建 test database、維運腳本。
# 非 superuser（superuser 會豁免權限檢查，本機就測不出 production 會缺的授權）。
# 一律直連 DB_DIRECT_PORT，不經 PgBouncer——transaction pooling 下 CREATE DATABASE
# 不可行，migration 的 advisory lock 與 CREATE INDEX CONCURRENTLY 語意也會壞。
DB_ADMIN_USER=lumina_owner
DB_ADMIN_PASSWORD=change-me-locally-owner
# 應用執行期唯一連線：非 superuser、非 owner、非 BYPASSRLS、無 DDL 權限。
DB_USER=lumina_app
DB_PASSWORD=change-me-locally
# 應用連線埠 = PgBouncer（05 §5.5：一律經連線池）
DB_PORT=16432
# PostgreSQL 直連埠：僅 pytest 用（建立/刪除 test database 無法經 PgBouncer）
DB_DIRECT_PORT=15432
# 05 §5.5 起始值為 2GB（16GB 主機）；開發機給 512MB 就夠
POSTGRES_SHARED_BUFFERS=512MB
# 對應 PgBouncer max_client_conn
POSTGRES_MAX_CONNECTIONS=200

# ── PgBouncer 運維帳號 ────────────────────────────────────────
# 與應用帳號（DB_USER）分開：這組才能對連線池下 PAUSE / KILL / RELOAD，
# 應用帳號只保留 SHOW（唯讀觀測）。帳號與密碼都不可與 DB_* 相同，render.sh 會擋。
# 這個帳號不需要存在於 PostgreSQL——PgBouncer 認的是自己的 userlist.txt。
PGBOUNCER_ADMIN_USER=pgbouncer_admin
PGBOUNCER_ADMIN_PASSWORD=change-me-locally-too

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-locally
REDIS_PORT=16379

# ── MinIO / S3 ────────────────────────────────────────────────
# root 憑證：只有 minio 容器與 minio-init 使用，應用永遠拿不到。
MINIO_ROOT_USER=lumina-root
MINIO_ROOT_PASSWORD=change-me-locally
# 應用的 service account：由 minio-init 建立，權限限於單一 bucket 的物件讀寫
#（不能刪 bucket、不能關 versioning、不能建其他 bucket）。不可與 root 憑證相同。
S3_ACCESS_KEY=lumina-app
S3_SECRET_KEY=change-me-locally-too
S3_BUCKET=lumina
S3_PORT=19000
S3_CONSOLE_PORT=19001

# ── 日誌（12 §1.1；生效點 backend/config/logging.py）─────────────
# 容器一律 json（stdout → Loki）；本機想看得舒服可改 console。
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Django ────────────────────────────────────────────────────
# Phase 0 起為必填（缺值即拒絕啟動）；本機隨意值即可，勿與正式環境共用
DJANGO_SECRET_KEY=change-me-locally

# ── 功能旗標 ──────────────────────────────────────────────────
# spike 壓測面：/api/v1/spike/* 端點 ＋ 從 X-Tenant-Id 標頭取租戶。兩者無認證且
# 違反 ADR-002，**預設關閉**（未設＝關）。只有跑 B 組壓測時才顯式開啟；
# 正式部署一律不要設此值。
# ENABLE_SPIKE_ENDPOINTS=true

# ── 執行環境（1A-3）────────────────────────────────────────────
# 只影響「為了本機方便而放寬」的設定：目前僅 refresh cookie 的 Secure 旗標。
# 未設時預設 production（嚴格那一邊）——漏設不該讓正式環境跑成開發設定。
ENVIRONMENT=development

# ── JWT（10 §2.1）──────────────────────────────────────────────
# 金鑰以 `make gen-jwt-keys` 產生於 backend/.secrets/（不進版控）。
# 路徑用預設值即可；正式環境由 Secrets Manager 掛檔案後覆寫這兩個變數。
# JWT_PRIVATE_KEY_PATH=backend/.secrets/jwt-es256.key
# JWT_PUBLIC_KEY_PATH=backend/.secrets/jwt-es256.pub
JWT_ACTIVE_KID=dev-1
